# Copy this file to .env (in the backend folder) and edit it.
# NEVER commit .env. It holds your database password and API keys.
PORT=3001

# MySQL (fake data only). The port is 3306 by default; use whatever your MySQL runs on.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# frontdesk_ai = small seed (db/seed.sql). frontdesk_ai_large = large seed (db/seed_large.sql).
DB_NAME=frontdesk_ai

# "Today" for the demo. The fake data is in Oct to Dec 2026, so pin the date.
# Delete this line to use the real clock.
APP_TODAY=2026-10-04

# How the chat understands a message:
#   rules     = built-in parser, no API key needed (default). English only.
#   openai    = OpenAI API (used in this project). English, Malay and Mandarin.
#   gemini / anthropic / local = other adapters, written but NOT tried against a live API.
# If the API call fails, the app falls back to the rules parser (unless LLM_STRICT=1).
LLM_PROVIDER=rules

# OpenAI (only needed when LLM_PROVIDER=openai). Paste your own key here, in .env only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# OPENAI_BASE_URL=
# OPENAI_REASONING_EFFORT=

# Other providers (only if you use them)
# GEMINI_API_KEY=
# GEMINI_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# LOCAL_BASE_URL=http://localhost:11434/v1
# LOCAL_MODEL=

# Set to 1 to show LLM failures instead of falling back to rules (used by the comparison runner)
# LLM_STRICT=0
