{
  "name": "accommodation-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/fds-web",
    "apps/booking-web",
    "apps/manager-mobile"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev:fds",
    "dev:fds": "npm run dev --workspace @fds/fds-web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "preview": "npm run preview --workspace @fds/fds-web",
    "dev:booking": "npm run dev --workspace @fds/booking-web",
    "dev:mobile": "npm run dev --workspace @fds/manager-mobile",
    "dev:mobile:web": "npm run web --workspace @fds/manager-mobile"
  }
}
