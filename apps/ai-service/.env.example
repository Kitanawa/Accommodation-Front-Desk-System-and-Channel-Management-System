# Copy to .env in this folder and edit. NEVER commit .env: it holds your API key.
# Port for this service. The FDS dev server forwards /api/ai here (default 3002).
AI_PORT=3002

# How a message is understood:
#   rules  = built-in parser, no key needed. English only.
#   openai = OpenAI API. English, Malay and Mandarin.
#   local  = any local server that speaks the OpenAI chat format (Ollama, LM Studio).
# If the model call fails, the service falls back to the rules parser (unless LLM_STRICT=1).
LLM_PROVIDER=rules

# OpenAI (only when LLM_PROVIDER=openai). Paste your own key here, in .env only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# OPENAI_BASE_URL=
# OPENAI_REASONING_EFFORT=

# local provider only
# LOCAL_BASE_URL=http://localhost:11434/v1
# LOCAL_MODEL=

# 1 = show model failures as "I did not understand" instead of falling back to rules
# LLM_STRICT=0

# "Today" for relative dates. Leave unset to use the real date in the time zone below.
# APP_TODAY=2026-10-26
# APP_TIMEZONE=Asia/Kuching

# --- Room and booking data (read-only) ---
# Leave AI_DATABASE_URL empty and the assistant only understands questions (no data).
# To read data: create the read-only database user once (db/create_readonly_role.sql, see README), then put ITS connection string here.
# Use the fds_ai_readonly user, NEVER the postgres or API user. The service refuses to read data if this user can write anything.
# AI_DATABASE_URL=postgres://fds_ai_readonly:YOUR_PASSWORD@localhost:5432/fds
# The team's API, used only to find out who is signed in (GET /api/me). Default http://127.0.0.1:3001
# API_URL=http://127.0.0.1:3001
