erDiagram
    room_types ||--o{ rate_rules : "priced by"
    users |o--o{ audit_records : acts

    room_types {
        uuid room_type_id PK
    }
    users {
        uuid user_id PK
    }
    rate_rules {
        uuid rate_rule_id PK
        uuid room_type_id FK
        varchar rule_type
        numeric rate_amount
        date date_from
        date date_to
        smallint_array selected_days
        date specific_date
        smallint priority
        varchar approval_status
        timestamptz created_at
    }
    audit_records {
        bigint audit_id PK
        uuid user_id FK
        varchar action
        varchar entity_type
        uuid entity_id
        jsonb old_values
        jsonb new_values
        timestamptz created_at
    }
